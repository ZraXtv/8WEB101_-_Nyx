# Dashboard Supabase → Project Settings → API Keys
# Copier ce fichier en .env.local puis remplacer les deux valeurs.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-du-projet>.supabase.co

# Nom actuel dans le dashboard. Les projets plus anciens exposent à la place
# NEXT_PUBLIC_SUPABASE_ANON_KEY (un JWT) : les deux noms sont acceptés.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Suivi sportif (facultatif) ---
# Clé TheSportsDB. Sans elle, la clé de test publique « 123 » est utilisée :
# elle fonctionne mais répond 429 au bout d'une trentaine d'appels rapprochés.
# PAS de préfixe NEXT_PUBLIC_ : cette clé ne doit jamais partir au navigateur.
SPORTSDB_KEY=123
